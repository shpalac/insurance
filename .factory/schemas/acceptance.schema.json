{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Factory executable acceptance issue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "issue_id",
    "title",
    "scope",
    "dependencies",
    "acceptance_criteria",
    "definition_of_done"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "issue_id": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 4
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_paths",
        "protected_paths"
      ],
      "properties": {
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "protected_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depends_on_issues",
        "multi_pr_allowed"
      ],
      "properties": {
        "depends_on_issues": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "multi_pr_allowed": {
          "type": "boolean"
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "verification_type",
          "runner_os",
          "command",
          "expected_exit_code",
          "required_report",
          "timeout_seconds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC-[1-9][0-9]*$"
          },
          "description": {
            "type": "string",
            "minLength": 15
          },
          "verification_type": {
            "enum": [
              "unit",
              "integration",
              "e2e",
              "contract",
              "performance",
              "static"
            ]
          },
          "runner_os": {
            "enum": [
              "ubuntu-latest",
              "macos-latest",
              "windows-latest"
            ]
          },
          "command": {
            "type": "string",
            "minLength": 5
          },
          "expected_exit_code": {
            "const": 0
          },
          "required_report": {
            "type": "string",
            "minLength": 3
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          },
          "services": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9./:_-]{0,100}$"
            }
          }
        }
      }
    },
    "definition_of_done": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "require_new_or_updated_tests",
        "min_diff_coverage_percent",
        "require_architecture_doc_sync"
      ],
      "properties": {
        "require_new_or_updated_tests": {
          "const": true
        },
        "min_diff_coverage_percent": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "require_architecture_doc_sync": {
          "type": "boolean"
        }
      }
    }
  }
}
